# --- Clerk (auth) ---
# From clerk.com dashboard > API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# --- Supabase (database + file storage) ---
# From supabase.com dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (subscriptions) ---
# From dashboard.stripe.com > Developers > API keys / Webhooks / Products
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- Anthropic (optional: "smart report" screenshot analysis) ---
# From console.anthropic.com > API Keys. If left blank, the report form
# still works fully -- it just won't auto-fill fields from screenshots.
ANTHROPIC_API_KEY=

# --- Cloudflare Turnstile (CAPTCHA on the public report form) ---
# From the Cloudflare dashboard > Turnstile > Add site. If left blank,
# the CAPTCHA widget won't render and submissions skip verification --
# fine for local dev, but set this before you launch publicly.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- App ---
# http://localhost:3000 while developing; your real domain once deployed
NEXT_PUBLIC_BASE_URL=http://localhost:3000
